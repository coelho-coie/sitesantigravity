# ==============================================================================
# Git Ignore - Castelos & Ruínas (Python / Flask Web Application)
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Ambientes Virtuais (Virtual Environments)
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Variáveis de Ambiente e Segredos
.env
.env.local
.env.*.local
*.env
!.env.example

# Flask e Instâncias Locais
instance/
.webassets-cache

# Bancos de Dados Locais
*.sqlite
*.sqlite3
*.db

# Testes, Cobertura e Linter
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Distribuição e Empacotamento
build/
dist/
*.egg-info/
*.egg
eggs/
.eggs/

# IDEs e Editores de Código
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Arquivos de Sistema Operacional (Windows / macOS / Linux)
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# Logs e Arquivos Temporários
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Saídas de Análise e Grafos Locais
graphify-out/

# Vercel Deployment Cache & Config
.vercel/
